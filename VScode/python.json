	"python logger class": {
	"prefix": "logger",
	"body": [
		"import logging\n",
		"class LOGGER:",
		"\t'''\n\tImport: use `import logging` at head of file\n\tUse:\t`with LOGGER() as LOG:`  then LOG.info / LOG.debug / LOG.warn / LOG.error / LOG.crit(\"msg\")\n\tWrites:  ./logs/<script>_logs.log and prints the time taken when the block ends.\n\tNote:   the msg value does't take and binary/ASCII or escape charaters  value paratmeter\n\t'''",
		"    def __init__(self):",
		"        os.makedirs(\"./logs\",exist_ok=True)",
		"        logging.basicConfig(filemode=\"w\",filename=f\"./logs/{os.path.basename(__file__)[:-3]}_logs.log\",level=logging.DEBUG,format=\"%(asctime)s [%(levelname)s]:\\t %(message)s\",datefmt=\"%d/%m/%Y %H:%M:%S\")",
		"        self.start=0.0\n",
		"    def __enter__(self):",
		"        logging.info(f\"{' start of execution ':-^50}\")",
		"        self.start=time.time()",
		"        return self",
		"    def __exit__(self,exc_type,exc,tb):",
		"        logging.info(f\"{' End of Execution ':-^50} [time taken:{(time.time()-self.start):.8f}]\")",
		"        print(f\"\\u001b[1;33m{'End of Execution':-^75}\\u001b[0m\")",
		"        return False\n",
		"    debug = lambda self,msg: logging.debug(msg)",
		"    info = lambda self,msg: logging.info(msg)",
		"    warn = lambda self,msg: logging.warning(msg)",
		"    error = lambda self,msg: logging.error(msg)",
		"    crit = lambda self,msg: logging.critical(msg)"
	],
	"description": "python logger class"
	},
